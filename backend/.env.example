# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/repairpass

# Authentication (JSON Web Token)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d

# 256-bit (32 bytes = 64 hex characters) key for OTP symmetric encryption
OTP_ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS_KEY
